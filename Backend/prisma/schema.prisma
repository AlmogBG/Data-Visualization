generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  idNumber   String    @id @map("id_number") @db.VarChar(20)
  username   String    @unique @db.VarChar(100)
  fullName   String    @map("full_name") @db.VarChar(150)
  email      String    @unique @db.VarChar(150)
  role       String    @db.VarChar(50)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  password   Password?
  consultationsCreated Consultation[] @relation("ConsultationCreatedBy")

  @@map("users")
}

model Password {
  idNumber     String    @id @map("id_number") @db.VarChar(20)
  passwordHash String    @map("password_hash")
  updatedAt    DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  user         User      @relation(fields: [idNumber], references: [idNumber], onDelete: Cascade)

  @@map("passwords")
}

model Department {
  id     Int    @id @default(autoincrement())
  name   String @unique
  leads  Lead[]

  @@map("departments")
}

model City {
  id      Int    @id @default(autoincrement())
  town    String @unique
  region  String
  leads   Lead[]

  @@map("cities")
}

model Lead {
  id             Int             @id @default(autoincrement())
  fullName       String          @map("full_name")
  phone          String?
  email          String?
  campus         String
  area           String
  status         String?
  source         String?
  createdAt      DateTime        @default(now()) @map("created_at")

  departmentId   Int             @map("department_id")
  cityId         Int             @map("city_id")

  department     Department      @relation(fields: [departmentId], references: [id])
  city           City            @relation(fields: [cityId], references: [id])
  consultations  Consultation[]

  @@map("leads")
}

model Consultation {
  id            Int       @id @default(autoincrement())
  leadId        Int       @map("lead_id")
  meetingDate   DateTime? @map("meeting_date")
  outcome       String?
  arrived       Boolean?
  notes         String?   @map("notes")
  googleEventId String?   @map("google_event_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  leadFullName       String? @map("lead_full_name")
  leadPhone          String? @map("lead_phone")
  leadEmail          String? @map("lead_email")
  leadCampus         String? @map("lead_campus")
  leadDepartmentName String? @map("lead_department_name")
  leadCityName       String? @map("lead_city_name")
  leadSource         String? @map("lead_source")

  createdById       String? @map("created_by_id") @db.VarChar(20)
  createdByUsername String? @map("created_by_username") @db.VarChar(100)

  lead              Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdByUser     User?  @relation("ConsultationCreatedBy", fields: [createdById], references: [idNumber], onDelete: SetNull)

  @@map("consultations")
}